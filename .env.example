# Copy to .env.local for development. Production values live in the host's settings.

# Where the NestJS API (aiainai-backend) runs. The browser calls /api on this app;
# Next.js forwards it here, so users only ever see one domain.
BACKEND_URL=http://localhost:4000

# Location of the backend's openapi.json for `pnpm api:types` (file path or URL).
# API_SPEC=../aiainai-backend/openapi.json

# Show "Continue with Google" (set to true once the backend has GOOGLE_CLIENT_ID/SECRET).
NEXT_PUBLIC_GOOGLE_SIGNIN=false
